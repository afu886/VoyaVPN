{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignoreWorkspaces": [".", "apps/mobile", "apps/web"],
  "workspaces": {
    "apps/desktop": {
      "entry": ["src/main.tsx!"],
      "project": ["src/**/*.{ts,tsx,css}!"],
      "ignore": ["e2e/**", "src/**/*.{test,spec}.{ts,tsx}", "src/**/*.test-fixture.ts", "src/test/**"],
      "ignoreDependencies": ["@tauri-apps/cli"],
      "ignoreIssues": {
        "src/ipc/bindings.ts": ["duplicates", "enumMembers", "exports", "types"]
      }
    },
    "packages/i18n": {
      "entry": ["src/index.ts", "src/use-i18n.ts"],
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["src/**/*.test.{ts,tsx}"]
    },
    "packages/ui": {
      "entry": ["src/components/*.{ts,tsx}", "src/lib/*.ts"],
      "project": ["src/**/*.{ts,tsx,css}!"],
      "ignore": ["src/**/*.test.{ts,tsx}", "src/test/setup.ts"]
    },
    "packages/utils": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["src/**/*.test.{ts,tsx}"]
    }
  }
}
